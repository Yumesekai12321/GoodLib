<div class="field <%= wide ? 'field-wide' : '' %>">
  <label for="<%= name %>"><%= label %><% if (required) { %> <span aria-hidden="true">*</span><% } %></label>
  <input id="<%= name %>" name="<%= name %>" type="<%= type %>" value="<%= values[name] ?? '' %>"
    <% if (required) { %> required <% } %>
    <% if (type === 'number') { %> min="0" max="<%= name === 'published_year' ? 9999 : 2147483647 %>" step="1" <% } %>
    <% if (type === 'text') { %> maxlength="<%= name === 'code' ? 32 : name === 'category' ? 100 : 200 %>" <% } %>
    aria-invalid="<%= errors[name] ? 'true' : 'false' %>" aria-describedby="<%= name %>-help<%= errors[name] ? ' ' + name + '-error' : '' %>" />
  <small id="<%= name %>-help" class="field-help"><%= help %></small>
  <% if (errors[name]) { %><p class="field-error" id="<%= name %>-error"><%= errors[name] %></p><% } %>
</div>
