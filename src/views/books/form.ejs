<%- include('../partials/header') %>
<a class="back-link" href="/books">← Danh mục sách</a>
<section class="page-heading compact"><div><p class="eyebrow">THƯ VIỆN / <%= id ? 'CHỈNH SỬA' : 'THÊM MỚI' %></p><h1><%= pageTitle %></h1><p class="subtitle">Thông tin đầy đủ giúp mỗi cuốn sách dễ được tìm thấy.</p></div></section>
<% if (Object.keys(errors).length) { %><div class="alert alert-error" role="alert" tabindex="-1" data-error-summary><strong>Chưa thể lưu sách.</strong> Kiểm tra các trường bên dưới.<% if (errors._form) { %><p><%= errors._form %></p><% } %></div><% } %>
<form class="book-form" method="post" action="<%= id ? '/books/' + id : '/books' %>" data-save-form>
  <div class="form-section-heading"><h2>Thông tin sách</h2><p><span aria-hidden="true">*</span> Trường bắt buộc</p></div>
  <div class="form-grid">
    <%- include('../partials/formField', { name: 'code', label: 'Mã sách', type: 'text', required: true, wide: false, help: '1–32 ký tự A–Z, số, _ hoặc -. Hệ thống tự chuyển thành chữ hoa.' }) %>
    <%- include('../partials/formField', { name: 'title', label: 'Tên sách', type: 'text', required: true, wide: false, help: 'Tối đa 200 ký tự, giữ nguyên dấu tiếng Việt.' }) %>
    <%- include('../partials/formField', { name: 'author', label: 'Tác giả', type: 'text', required: false, wide: false, help: 'Có thể bổ sung sau.' }) %>
    <%- include('../partials/formField', { name: 'category', label: 'Thể loại', type: 'text', required: false, wide: false, help: 'Ví dụ: Văn học, Thiếu nhi, Tin học.' }) %>
    <%- include('../partials/formField', { name: 'published_year', label: 'Năm xuất bản', type: 'number', required: false, wide: false, help: 'Số nguyên 0–9999; để trống nếu chưa rõ.' }) %>
    <%- include('../partials/formField', { name: 'total_quantity', label: 'Tổng số cuốn', type: 'number', required: true, wide: false, help: 'Số nguyên không âm; không thấp hơn số cuốn chưa trả.' }) %>
  </div>
  <aside class="stock-note"><strong>Số còn do hệ thống cập nhật</strong><p>Số còn = tổng − số cuốn chưa trả. Sprint 1 chưa có mượn sách nên số còn bằng tổng.</p><% if (id) { %><p>Trước khi lưu: tổng <%= values.total_quantity %> · số còn <%= values.available_quantity ?? '—' %>.</p><% } %></aside>
  <div class="form-actions"><a class="button button-secondary" href="/books">Hủy</a><button class="button button-primary" type="submit"><%= id ? 'Lưu thay đổi' : 'Thêm sách' %></button></div>
</form>
<%- include('../partials/footer') %>
