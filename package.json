{
  "name": "goodlib",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GoodLib — quản lý danh mục sách, Sprint 1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env db/seeds/demo.js",
    "db:audit": "node --env-file-if-exists=.env scripts/audit-stock.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "globals": "17.4.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
